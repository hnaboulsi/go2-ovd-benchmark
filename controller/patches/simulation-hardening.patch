+    def test_failed_and_nonfinite_solutions_are_rejected(self):
+        checker = CentroidalMPC.__new__(CentroidalMPC)
+        checker.nvars = 2
+        with self.assertRaisesRegex(RuntimeError, "primal infeasible"):
