index 0000000..5c50a53
--- /dev/null
+++ b/examples/validate_mpc.py
@@ -0,0 +1,368 @@
+"""Deterministic headless validation for the Go2 convex MPC control path."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import time
+from pathlib import Path
+
+import matplotlib
+import mujoco as mj
+import numpy as np
+from convex_mpc.safety_checks import clip_torque, saturation_metrics
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+
+from convex_mpc.centroidal_mpc import MU, RAW_SWING_FORCE_TOL, CentroidalMPC
+from convex_mpc.com_trajectory import ComTraj
+from convex_mpc.gait import Gait, LEG_ORDER
+from convex_mpc.go2_robot_data import PinGo2Model
+from convex_mpc.leg_controller import LegController
+from convex_mpc.mujoco_model import MuJoCo_GO2_Model
+
+
+SIM_HZ = 1000
+CTRL_HZ = 200
+SIM_DT = 1.0 / SIM_HZ
+CTRL_DT = 1.0 / CTRL_HZ
+CTRL_DECIM = SIM_HZ // CTRL_HZ
+RUN_LENGTH_S = 8.0
+
+GAIT_HZ = 3.0
+GAIT_DUTY = 0.6
+MPC_DT = (1.0 / GAIT_HZ) / 16.0
+MPC_HZ = 1.0 / MPC_DT
+STEPS_PER_MPC = max(1, int(CTRL_HZ // MPC_HZ))
+
+TAU_LIM = 0.9 * np.array(
+    [23.7, 23.7, 45.43] * 4, dtype=float
+)
+LEG_SLICE = {leg: slice(3 * i, 3 * i + 3) for i, leg in enumerate(LEG_ORDER)}
+
+
+def command_at(t: float):
+    """Return body-frame ``vx, vy, z, yaw_rate`` and a stage label."""
+    if t < 1.0:
+        return 0.0, 0.0, 0.27, 0.0, "height_hold"
+    if t < 3.0:
+        return 0.0, 0.0, 0.27, 0.0, "trot_in_place"
+    if t < 6.0:
+        return 0.3, 0.0, 0.27, 0.0, "slow_forward"
+    return 0.0, 0.0, 0.27, 0.0, "stop"
+
+
+def _constraint_metrics(raw_u: np.ndarray, contact: np.ndarray):
+    forces = raw_u.reshape(4, 3, raw_u.shape[1])
+    force_by_step = forces.transpose(2, 0, 1)
+    swing_abs = np.abs(force_by_step[~contact.T])
+    stance = force_by_step[contact.T]
+    raw_swing_max = float(np.max(swing_abs)) if swing_abs.size else 0.0
+    if stance.size:
+        stance_min_fz = float(np.min(stance[:, 2]))
+        friction_violation = float(
+            np.max(
+                np.maximum(
+                    np.abs(stance[:, :2]) - MU * stance[:, 2, None],
+                    0.0,
+                )
+            )
+        )
+    else:
+        stance_min_fz = 0.0
+        friction_violation = 0.0
+    return raw_swing_max, stance_min_fz, friction_violation
+
+
+def _save_plots(output_dir: Path, log: dict):
+    t = log["time"]
+    actual = log["actual_state"]
+    desired = log["desired_state"]
+    contact = log["contact"]
+    raw = log["raw_grf"]
+    applied = log["applied_grf"]
+
+    fig, axes = plt.subplots(4, 1, figsize=(12, 12), sharex=True)
+    labels = ((0, 3, "position (m)"), (6, 9, "linear velocity (m/s)"),
+              (3, 6, "roll/pitch/yaw (rad)"), (9, 12, "angular velocity (rad/s)"))
+    xyz = ("x", "y", "z")
+    for axis, (start, end, ylabel) in zip(axes, labels):
+        for component, name in enumerate(xyz):
+            axis.plot(t, actual[:, start + component], label=f"actual {name}")
+            axis.plot(t, desired[:, start + component], "--", label=f"desired {name}")
+        axis.set_ylabel(ylabel)
+        axis.grid(True)
+        axis.legend(ncol=3, fontsize=8)
+    axes[-1].set_xlabel("time (s)")
+    fig.tight_layout()
+    fig.savefig(output_dir / "state_tracking.png", dpi=160)
+    plt.close(fig)
+
+    fig, axes = plt.subplots(4, 1, figsize=(12, 11), sharex=True)
+    for leg, axis in enumerate(axes):
+        for component, name in enumerate(xyz):
+            column = 3 * leg + component
+            axis.plot(t, raw[:, column], ":", alpha=0.75, label=f"raw {name}")
+            axis.plot(t, applied[:, column], label=f"applied {name}")
+        axis.step(t, 20.0 * contact[:, leg], where="post", color="black", alpha=0.4,
+                  label="contact x20")
+        axis.set_ylabel(f"{LEG_ORDER[leg]} force (N)")
+        axis.grid(True)
+        axis.legend(ncol=4, fontsize=8)
+    axes[-1].set_xlabel("time (s)")
+    fig.tight_layout()
+    fig.savefig(output_dir / "contact_forces.png", dpi=160)
+    plt.close(fig)
+
+    fig, axes = plt.subplots(4, 1, figsize=(12, 10), sharex=True)
+    torque = log["joint_torque"]
+    for leg, axis in enumerate(axes):
+        for component, name in enumerate(("hip", "thigh", "calf")):
+            axis.plot(t, log["joint_torque_demand"][:, 3 * leg + component], ":", alpha=.65, label=f"{name} demand")
+            axis.plot(t, torque[:, 3 * leg + component], label=f"{name} clipped")
+        axis.set_ylabel(f"{LEG_ORDER[leg]} torque (Nm)")
+        axis.grid(True)
+        axis.legend(ncol=3, fontsize=8)
+    axes[-1].set_xlabel("time (s)")
+    fig.tight_layout()
+    fig.savefig(output_dir / "joint_torques.png", dpi=160)
+    plt.close(fig)
+
+    fig, axes = plt.subplots(2, 1, figsize=(12, 7), sharex=False)
+    axes[0].plot(log["mpc_time"], log["mpc_update_ms"], label="QP update")
+    axes[0].plot(log["mpc_time"], log["mpc_solve_ms"], label="QP solve")
+    axes[0].axhline(MPC_DT * 1e3, color="red", linestyle="--", label="20.8 ms budget")
+    axes[0].set_ylabel("MPC latency (ms)")
+    axes[0].legend()
+    axes[0].grid(True)
+    axes[1].plot(t, log["control_tick_ms"], label="200 Hz control tick")
+    axes[1].axhline(CTRL_DT * 1e3, color="red", linestyle="--", label="5 ms deadline")
+    axes[1].set_xlabel("time (s)")
+    axes[1].set_ylabel("control latency (ms)")
+    axes[1].legend()
+    axes[1].grid(True)
+    fig.tight_layout()
+    fig.savefig(output_dir / "timing.png", dpi=160)
+    plt.close(fig)
+
+
+def run_validation(output_dir: Path, replay: bool = False):
+    if SIM_HZ % CTRL_HZ != 0:
+        raise ValueError("simulation rate must be divisible by control rate")
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    go2 = PinGo2Model()
+    sim = MuJoCo_GO2_Model()
+    gait = Gait(GAIT_HZ, GAIT_DUTY)
+    traj = ComTraj(go2)
+    leg_controller = LegController()
+
+    q_init = go2.current_config.get_q()
+    q_init[0] = -5.0
+    sim.update_with_q_pin(q_init)
+    sim.model.opt.timestep = SIM_DT
+    traj.generate_traj(go2, gait, 0.0, 0.0, 0.0, 0.27, 0.0, MPC_DT)
+    mpc = CentroidalMPC(go2, traj)
+
+    control_steps = int(RUN_LENGTH_S * CTRL_HZ)
+    sim_steps = int(RUN_LENGTH_S * SIM_HZ)
+    log = {
+        "time": np.zeros(control_steps),
+        "actual_state": np.zeros((control_steps, 12)),
+        "desired_state": np.zeros((control_steps, 12)),
+        "contact": np.zeros((control_steps, 4), dtype=np.int32),
+        "raw_grf": np.zeros((control_steps, 12)),
+        "applied_grf": np.zeros((control_steps, 12)),
+        "joint_torque": np.zeros((control_steps, 12)),
+        "joint_torque_demand": np.zeros((control_steps, 12)),
+        "torque_clipping": np.zeros((control_steps, 12)),
+        "control_tick_ms": np.zeros(control_steps),
+        "stage": np.empty(control_steps, dtype=object),
+        "mpc_time": [],
+        "mpc_update_ms": [],
+        "mpc_solve_ms": [],
+        "solver_status": [],
+    }
+    render_time, render_q, render_tau = [], [], []
+    next_render_t = 0.0
+    render_dt = 1.0 / 120.0
+
+    ctrl_i = 0
+    tau_hold = np.zeros(12)
+    U_raw = np.zeros((12, traj.N))
+    last_contact = None
+    max_raw_swing = 0.0
+    min_stance_fz = np.inf
+    max_friction_violation = 0.0
+
+    for sim_i in range(sim_steps):
+        now = float(sim.data.time)
+        if sim_i % CTRL_DECIM == 0:
+            tick_start = time.perf_counter()
+            vx, vy, z_ref, yaw_rate, stage = command_at(now)
+            sim.update_pin_with_mujoco(go2)
+            actual = go2.compute_com_x_vec().reshape(12)
+            current_contact = gait.compute_current_mask(now)
+            transition = last_contact is None or not np.array_equal(current_contact, last_contact)
+
+            if ctrl_i % STEPS_PER_MPC == 0 or transition:
+                traj.generate_traj(go2, gait, now, vx, vy, z_ref, yaw_rate, MPC_DT)
+                solution = mpc.solve_QP(go2, traj)
+                _, U_raw = mpc.extract_solution(solution, traj, current_contact)
+                raw_swing, stance_fz, friction = _constraint_metrics(
+                    U_raw, traj.contact_table.astype(bool)
+                )
+                max_raw_swing = max(max_raw_swing, raw_swing)
+                min_stance_fz = min(min_stance_fz, stance_fz)
+                max_friction_violation = max(max_friction_violation, friction)
+                log["mpc_time"].append(now)
+                log["mpc_update_ms"].append(mpc.update_time)
+                log["mpc_solve_ms"].append(mpc.solve_time)
+                log["solver_status"].append(str(mpc.last_status))
+
+            raw_first = U_raw[:, 0].copy()
+            applied = mpc.apply_contact_mask(raw_first, current_contact)
+            desired = np.concatenate(
+                [traj.pos_traj_world[:, 0], traj.rpy_traj_world[:, 0],
+                 traj.vel_traj_world[:, 0], traj.omega_traj_world[:, 0]]
+            )
+
+            tau_raw = np.zeros(12)
+            for leg in LEG_ORDER:
+                sl = LEG_SLICE[leg]
+                result = leg_controller.compute_leg_torque(
+                    leg, go2, gait, applied[sl], now, contact_mask=current_contact
+                )
+                tau_raw[sl] = result.tau
+            tau_hold = clip_torque(tau_raw, TAU_LIM)
+
+            log["time"][ctrl_i] = now
+            log["actual_state"][ctrl_i] = actual
+            log["desired_state"][ctrl_i] = desired
+            log["contact"][ctrl_i] = current_contact
+            log["raw_grf"][ctrl_i] = raw_first
+            log["applied_grf"][ctrl_i] = applied
+            log["joint_torque_demand"][ctrl_i] = tau_raw
+            log["torque_clipping"][ctrl_i] = np.abs(tau_raw - tau_hold)
+            log["joint_torque"][ctrl_i] = tau_hold
+            log["stage"][ctrl_i] = stage
+            last_contact = current_contact.copy()
+            ctrl_i += 1
+
+        mj.mj_step1(sim.model, sim.data)
+        sim.set_joint_torque(tau_hold)
+        mj.mj_step2(sim.model, sim.data)
+        after = float(sim.data.time)
+        if after + 1e-12 >= next_render_t:
+            render_time.append(after)
+            render_q.append(sim.data.qpos.copy())
+            render_tau.append(tau_hold.copy())
+            next_render_t += render_dt
+        # Full control interval workload: sensing through all five physics/
+        # actuator substeps and logging. No pacing sleep or hardware transport.
+        if (sim_i + 1) % CTRL_DECIM == 0:
+            log["control_tick_ms"][ctrl_i - 1] = (time.perf_counter() - tick_start) * 1e3
+
+    for key in ("time", "actual_state", "desired_state", "contact", "raw_grf",
+                "applied_grf", "joint_torque", "joint_torque_demand", "torque_clipping", "control_tick_ms", "stage"):
+        log[key] = log[key][:ctrl_i]
+    for key in ("mpc_time", "mpc_update_ms", "mpc_solve_ms"):
+        log[key] = np.asarray(log[key], dtype=float)
+
+    t = log["time"]
+    actual = log["actual_state"]
+    applied_legs = log["applied_grf"].reshape(-1, 4, 3)
+    swing = ~log["contact"].astype(bool)
+    applied_swing = np.abs(applied_legs[swing])
+    applied_swing_max = float(np.max(applied_swing)) if applied_swing.size else 0.0
+    vertical = np.sum(log["applied_grf"][:, [2, 5, 8, 11]], axis=1)
+    weight = float(go2.data.Ig.mass) * 9.81
+    support_window = (t >= 1.0) & (t < 3.0)
+    forward_window = (t >= 3.5) & (t < 6.0)
+    stop_window = t >= 7.5
+    support_ratio = float(np.mean(vertical[support_window]) / weight)
+    forward_vx = float(np.mean(actual[forward_window, 6]))
+    forward_dx = float(actual[t < 6.0][-1, 0] - actual[t >= 3.0][0, 0])
+    stop_speed = float(np.mean(np.linalg.norm(actual[stop_window, 6:8], axis=1)))
+    mpc_total = log["mpc_update_ms"] + log["mpc_solve_ms"]
+    overrun_idx = np.flatnonzero(log["control_tick_ms"] > CTRL_DT * 1e3)
+
+    checks = {
+        "all_qp_solved": bool(log["solver_status"] and set(log["solver_status"]) == {"solved"}),
+        "raw_swing_within_solver_tolerance": max_raw_swing <= RAW_SWING_FORCE_TOL,
+        "applied_swing_exact_zero": applied_swing_max == 0.0,
+        "stance_normal_force_nonnegative": min_stance_fz >= -2e-2,
+        "friction_pyramid_satisfied": max_friction_violation <= 2e-2,
+        "joint_torque_limits_satisfied": bool(
+            np.all(np.abs(log["joint_torque"]) <= TAU_LIM[None, :] + 1e-12)
+        ),
+        "vertical_support_consistent": 0.75 <= support_ratio <= 1.25,
+        "height_in_range": bool(np.min(actual[:, 2]) >= 0.22 and np.max(actual[:, 2]) <= 0.32),
+        "upright": bool(np.max(np.abs(actual[:, 3:5])) <= 0.20),
+        "forward_command_tracks_positive": forward_vx > 0.15 and forward_dx > 0.0,
+        "stops_after_command": stop_speed < 0.15,
+        "mpc_p95_within_budget": float(np.percentile(mpc_total, 95)) < MPC_DT * 1e3,
+    }
+    metrics = {
+        "torque_saturation": saturation_metrics(log["joint_torque_demand"], log["joint_torque"]),
+        "control_timing_scope": "sensing through all physics/actuator substeps and logging; excludes pacing sleep; no hardware transport",
+        "control_ticks": ctrl_i,
+        "mpc_solves": len(log["solver_status"]),
+        "solver_status_counts": {
+            status: log["solver_status"].count(status) for status in sorted(set(log["solver_status"]))
+        },
+        "robot_mass_kg": float(go2.data.Ig.mass),
+        "weight_n": weight,
+        "raw_swing_force_max_abs_n": max_raw_swing,
+        "applied_swing_force_max_abs_n": applied_swing_max,
+        "stance_normal_force_min_n": float(min_stance_fz),
+        "friction_pyramid_max_violation_n": max_friction_violation,
+        "vertical_support_ratio": support_ratio,
+        "height_min_m": float(np.min(actual[:, 2])),
+        "height_max_m": float(np.max(actual[:, 2])),
+        "max_abs_roll_rad": float(np.max(np.abs(actual[:, 3]))),
+        "max_abs_pitch_rad": float(np.max(np.abs(actual[:, 4]))),
+        "forward_mean_vx_mps": forward_vx,
+        "forward_displacement_m": forward_dx,
+        "stopped_mean_planar_speed_mps": stop_speed,
+        "mpc_total_p95_ms": float(np.percentile(mpc_total, 95)),
+        "mpc_total_max_ms": float(np.max(mpc_total)),
+        "control_tick_p95_ms": float(np.percentile(log["control_tick_ms"], 95)),
+        "control_tick_max_ms": float(np.max(log["control_tick_ms"])),
+        "control_deadline_overrun_count": int(overrun_idx.size),
+        "control_deadline_overrun_times_s": [float(t[i]) for i in overrun_idx],
+    }
+    report = {"passed": bool(all(checks.values())), "checks": checks, "metrics": metrics}
+    (output_dir / "report.json").write_text(json.dumps(report, indent=2) + "\n")
+    np.savez_compressed(
+        output_dir / "control_log.npz",
+        **{
+            key: (value.astype(str) if key == "stage" else value)
+            for key, value in log.items() if key != "solver_status"
+        },
+        solver_status=np.asarray(log["solver_status"], dtype=str),
+    )
+    _save_plots(output_dir, log)
+
+    print(json.dumps(report, indent=2))
+    print(f"Saved validation artifacts to {output_dir}")
+    if replay:
+        sim.replay_simulation(
+            np.asarray(render_time), np.asarray(render_q), np.asarray(render_tau), render_dt, 1.0
+        )
+    if not report["passed"]:
+        raise SystemExit(1)
+    return report
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, default=Path("work/validation_output"))
+    parser.add_argument("--replay", action="store_true", help="Replay the validated run in MuJoCo")
+    args = parser.parse_args()
+    run_validation(args.output_dir, replay=args.replay)
+
+
+if __name__ == "__main__":
+    main()
