+    def __init__(self, value):
+        self._value = np.asarray(value, dtype=float)
+
+    def full(self):
+        return self._value
+
+
+class MPCFormulationTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.go2 = PinGo2Model()
+        cls.gait = Gait(frequency_hz=3.0, duty=0.6)
+        cls.dt = cls.gait.gait_period / 16.0
+        cls.traj = ComTraj(cls.go2)
+        cls.traj.generate_traj(
+            cls.go2,
+            cls.gait,
+            time_now=0.0,
+            x_vel_des_body=0.0,
+            y_vel_des_body=0.0,
+            z_pos_des_body=0.27,
+            yaw_rate_des_body=0.0,
+            time_step=cls.dt,
+        )
+        cls.mpc = CentroidalMPC(cls.go2, cls.traj)
+        cls.solution = cls.mpc.solve_QP(cls.go2, cls.traj)
+        cls.X_opt, cls.U_raw = cls.mpc.extract_solution(
+            cls.solution, cls.traj, cls.gait.compute_current_mask(0.0)
+        )
+
+    def test_dimensions_and_horizon(self):
+        self.assertEqual(self.traj.N, 16)
+        self.assertEqual(self.traj.compute_x_ref_vec().shape, (NX, 16))
+        self.assertEqual(self.traj.contact_table.shape, (len(LEG_ORDER), 16))
+        self.assertEqual(self.traj.Ad.shape, (NX, NX))
+        self.assertEqual(self.traj.Bd.shape, (16, NX, NU))
+        self.assertEqual(self.mpc.H_const.size(), (384, 384))
+        self.assertEqual(self.mpc.A_sp.size(), (448, 384))
+        self.assertEqual(self.X_opt.shape, (NX, 16))
+        self.assertEqual(self.U_raw.shape, (NU, 16))
+
+    def test_contact_table_starts_at_current_control_instant(self):
+        for time_now in (0.0, 0.035, 0.2, 0.335, 1.217):
+            table = self.gait.compute_contact_table(time_now, self.dt, 16)
+            np.testing.assert_array_equal(
+                table[:, 0], self.gait.compute_current_mask(time_now)
+            )
+        np.testing.assert_array_equal(
+            self.gait.compute_current_mask(0.1), np.array([0, 1, 1, 0])
+        )
+
+    def test_world_gravity_has_negative_z_sign(self):
+        self.assertAlmostEqual(float(self.traj.gd[2, 0]), -0.5 * 9.81 * self.dt**2)
+        self.assertAlmostEqual(float(self.traj.gd[8, 0]), -9.81 * self.dt)
+        np.testing.assert_allclose(self.traj.gd[[0, 1, 6, 7]], 0.0)
+
+    def test_contact_force_constraints(self):
+        contact = self.traj.contact_table.astype(bool)
+        force = self.U_raw.reshape(4, 3, self.traj.N)
+        force_by_step = force.transpose(2, 0, 1)
+        self.assertLessEqual(
+            float(np.max(np.abs(force_by_step[~contact.T]))), RAW_SWING_FORCE_TOL
+        )
+
+        stance_fz = force[:, 2, :][contact]
+        self.assertGreaterEqual(float(np.min(stance_fz)), -2e-2)
+        for leg in range(4):
+            for k in range(self.traj.N):
+                if not contact[leg, k]:
+                    continue
+                fx, fy, fz = force[leg, :, k]
+                self.assertLessEqual(abs(fx), MU * fz + 2e-2)
+                self.assertLessEqual(abs(fy), MU * fz + 2e-2)
+
+        current = np.array([0, 1, 1, 0], dtype=np.int32)
+        synthetic_raw = np.arange(1.0, 13.0)
+        applied = self.mpc.apply_contact_mask(synthetic_raw, current)
+        np.testing.assert_array_equal(
+            applied.reshape(4, 3)[~current.astype(bool)], 0.0
+        )
+        np.testing.assert_array_equal(
+            applied.reshape(4, 3)[current.astype(bool)],
+            synthetic_raw.reshape(4, 3)[current.astype(bool)],
+        )
+
+    def test_stance_forces_have_no_invented_upper_bound(self):
+        _, upper = self.mpc._compute_bounds(self.traj)
+        upper = np.asarray(upper, dtype=float).reshape(-1)
+        force_upper = upper[self.traj.N * NX:].reshape(NU, self.traj.N, order="F")
+        contact_xyz = np.repeat(self.traj.contact_table.astype(bool), 3, axis=0)
+        self.assertTrue(np.all(np.isposinf(force_upper[contact_xyz])))
+
