+from convex_mpc.centroidal_mpc import CentroidalMPC
+from convex_mpc.leg_controller import LegController
+from convex_mpc.gait import Gait
+import test_mpc_formulation as formulation
+
+
+class SafetyChecksTests(unittest.TestCase):
+    def test_invalid_contacts_fail_closed_without_modifying_input(self):
+        raw = np.ones(12)
+        for bad in (np.nan, np.inf, -np.inf, 2, -1, 0.5):
+            with self.subTest(bad=bad):
+                mask = np.array([bad, 0, 1, 0])
+                with self.assertRaises(ValueError):
+                    CentroidalMPC.apply_contact_mask(raw, mask)
+                with self.assertRaises(ValueError):
+                    binary_contacts(np.full((4, 16), bad), (4, 16))
+                with self.assertRaises(ValueError):
+                    LegController().compute_leg_torque("FL", None, None, np.zeros(3), 0, mask)
+        np.testing.assert_array_equal(raw, np.ones(12))
+        with self.assertRaises(ValueError):
+            binary_contacts(np.ones((4, 1)), (4,))
+
+    def test_bad_gait_time_and_parameters(self):
+        for bad in (np.nan, np.inf):
+            with self.assertRaises(ValueError):
+                Gait(bad, .6)
+            with self.assertRaises(ValueError):
+                Gait(3, bad)
+            with self.assertRaises(ValueError):
+                Gait(3, .6).compute_current_mask(bad)
+
+    def test_clipping_and_saturation_metrics(self):
+        demand = np.array([[2., -3., .5], [0., 0., 0.]])
+        clipped = np.stack([clip_torque(row, np.ones(3)) for row in demand])
+        result = saturation_metrics(demand, clipped)
+        self.assertEqual(result["saturated_joint_samples"], 2)
+        self.assertEqual(result["saturated_ticks"], 1)
+        self.assertEqual(result["maximum_clipping_Nm"], 2)
+        self.assertEqual(result["per_joint_counts"], [1, 1, 0])
+        for bad in (np.nan, np.inf):
+            with self.assertRaises(ValueError):
+                clip_torque([bad], [1])
+
+
