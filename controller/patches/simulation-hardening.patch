--- /dev/null
+++ b/src/convex_mpc/safety_checks.py
@@ -0,0 +1,32 @@
+"""Input checks, not a hardware safety controller."""
+import numpy as np
+
+
+def binary_contacts(value, shape):
+    """Reject before casting. Invalid contacts never become stance commands."""
+    array = np.asarray(value)
+    if array.shape != shape or not np.all(np.isfinite(array)):
+        raise ValueError(f"contacts must be finite with shape {shape}")
+    if not np.all((array == 0) | (array == 1)):
+        raise ValueError("contacts must contain only binary 0/1 values")
+    return array.astype(bool)
+
+
+def clip_torque(demand, limits):
+    demand, limits = np.asarray(demand), np.asarray(limits)
+    if demand.shape != limits.shape or not np.all(np.isfinite(demand)):
+        raise ValueError("torque demand must be finite and match limits")
+    if not np.all(np.isfinite(limits)) or np.any(limits <= 0):
+        raise ValueError("torque limits must be finite and positive")
+    return np.clip(demand, -limits, limits)
+
+
+def saturation_metrics(demand, clipped):
+    excess = np.abs(np.asarray(demand) - np.asarray(clipped))
+    return {
+        "saturated_joint_samples": int(np.count_nonzero(excess)),
+        "saturated_ticks": int(np.count_nonzero(np.any(excess > 0, axis=-1))),
+        "maximum_clipping_Nm": float(np.max(excess, initial=0)),
+        "per_joint_counts": np.count_nonzero(excess, axis=0).tolist(),
+        "per_joint_maximum_clipping_Nm": np.max(excess, axis=0).tolist(),
+    }
